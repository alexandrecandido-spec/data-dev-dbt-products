with marketing as (
    select *
    from {{ source('data_marketing', 'marketing_attribution_model') }}
    where year_month_day_code >= 20250101
),

qualified_orders as (
    select *
    from {{ ref('first_7_orders') }}
)

select
    ma.store_id,
    date(min(fs.completed_at)) as first_seller
from marketing ma
left join qualified_orders fs
    on ma.store_id = fs.store_id
group by ma.store_id